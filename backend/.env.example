# Copia este archivo como .env y cambia los valores. Nunca subas el .env a git.
PORT=4000
NODE_ENV=development

# MySQL local: mysql://USUARIO:CLAVE@HOST:PUERTO/BASE
DATABASE_URL=mysql://root:cambia-esta-clave@localhost:3306/mototrack

# Genera cada secreto con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia-este-secreto-de-acceso-por-uno-largo
JWT_REFRESH_SECRET=cambia-este-secreto-de-renovacion-por-otro-largo
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Dirección del frontend que puede llamar a la API
CORS_ORIGIN=http://localhost:5173
