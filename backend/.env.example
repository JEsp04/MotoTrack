# Copia este archivo como .env y cambia los valores. Nunca subas el .env a git.
PORT=4000
NODE_ENV=development

# MySQL local: mysql://USUARIO:CLAVE@HOST:PUERTO/BASE
DATABASE_URL=mysql://root:cambia-esta-clave@localhost:3306/mototrack

# Genera cada secreto con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia-este-secreto-de-acceso-por-uno-largo
JWT_REFRESH_SECRET=cambia-este-secreto-de-renovacion-por-otro-largo
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Dirección del frontend que puede llamar a la API
CORS_ORIGIN=http://localhost:5173

# Base solo para pruebas (npm test). Debe terminar en _test
TEST_DATABASE_URL=mysql://root:cambia-esta-clave@localhost:3306/mototrack_test

# HU-79 · Asistente IA de diagnóstico (opcional: sin llave, el asistente sale apagado)
# La llave se crea en console.anthropic.com > API Keys. Va solo aquí, nunca en el frontend.
ANTHROPIC_API_KEY=
# claude-haiku-5-5 es el más barato; claude-opus-5-5 da mejores respuestas
ANTHROPIC_MODEL=claude-haiku-5-5
# Respuestas del asistente por usuario y por día
ASISTENTE_LIMITE_DIARIO=10

# HU-81 · Pasarela de pagos simulada (tarjeta de prueba, no cobra nada)
# Clave con la que la pasarela firma los pagos. Mínimo 32 caracteres.
PASARELA_SECRETO=cambia-esta-clave-de-la-pasarela-demo-32
